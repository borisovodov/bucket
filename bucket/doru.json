{
    "version": "0.0.24",
    "description": "Local-first genealogy for the AI era",
    "homepage": "https://doru.family",
    "license": "MIT",
    "notes": [
        "For .doru, .ged and .gdz file associations, run:",
        "reg import \"$dir\\install-associations.reg\""
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/borisovodov/doru/releases/download/v0.0.24/doru-windows-x64.zip",
            "hash": "2792516876018194e7d7ee01518155f027d043f3414d15dd579e598570e88a4b"
        },
        "arm64": {
            "url": "https://github.com/borisovodov/doru/releases/download/v0.0.24/doru-windows-arm64.zip",
            "hash": "ffc38b78eff70a4d8e8ba269b1fc7527c5400afa336e83e65cf29efc43e8c90b"
        }
    },
    "shortcuts": [
        [
            "doru.exe",
            "Dóru"
        ]
    ],
    "post_install": [
        "# Materialize the association .reg templates with this install's path",
        "'install-associations', 'uninstall-associations' | ForEach-Object {",
        "    if (Test-Path \"$bucketsdir\\$bucket\\scripts\\doru\\$_.reg\") {",
        "        $doruPath = \"$dir\".Replace('\\', '\\\\')",
        "        $content = (Get-Content \"$bucketsdir\\$bucket\\scripts\\doru\\$_.reg\" -Raw -Encoding UTF8).Replace('$doru', $doruPath)",
        "        if ($global) { $content = $content.Replace('HKEY_CURRENT_USER', 'HKEY_LOCAL_MACHINE') }",
        "        Set-Content \"$dir\\$_.reg\" $content -Encoding Unicode -Force",
        "    }",
        "}",
        "# Re-register file associations if they are already registered to this installation",
        "$regpath = 'HKCU:\\Software\\Classes\\Doru.Tree\\shell\\open\\command'",
        "if ($global) {",
        "    $regpath = $regpath.Replace('HKCU', 'HKLM')",
        "}",
        "$command = Get-ItemPropertyValue $regpath -Name '(default)' -ErrorAction Ignore",
        "if ($command -and ($command -match [regex]::escape($(appdir $app $global)))) {",
        "    info 'Re-registering file associations...'",
        "    reg import \"$dir\\install-associations.reg\"",
        "}"
    ],
    "uninstaller": {
        "script": "if ($cmd -eq 'uninstall') { reg import \"$dir\\uninstall-associations.reg\" }"
    },
    "checkver": {
        "github": "https://github.com/borisovodov/doru"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/borisovodov/doru/releases/download/v$version/doru-windows-x64.zip",
                "hash": {
                    "url": "https://api.github.com/repos/borisovodov/doru/releases/latest",
                    "jsonpath": "$.assets[?(@.name=='doru-windows-x64.zip')].digest"
                }
            },
            "arm64": {
                "url": "https://github.com/borisovodov/doru/releases/download/v$version/doru-windows-arm64.zip",
                "hash": {
                    "url": "https://api.github.com/repos/borisovodov/doru/releases/latest",
                    "jsonpath": "$.assets[?(@.name=='doru-windows-arm64.zip')].digest"
                }
            }
        }
    }
}
